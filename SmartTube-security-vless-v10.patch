+++ smarttube_work/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/VlessProfileStore.java	2026-10-29 16:23:43.751489716 +0000
@@ -0,0 +1,34 @@
+package com.liskovsoft.smartyoutubetv2.common.proxy.vless;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Stores a single imported VLESS profile in app-private preferences. Never logs the URI. */
+public final class VlessProfileStore {
+    private static final String PREFS = "vless_profile_private";
+    private static final String KEY_SHARE_URI = "share_uri";
+    private final SharedPreferences preferences;
+
+    public VlessProfileStore(Context context) {
+        preferences = context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public String getShareUri() {
+        return preferences.getString(KEY_SHARE_URI, "");
+    }
+
+    public boolean hasProfile() {
+        return !getShareUri().isEmpty();
+    }
+
+    public void saveShareUri(String shareUri) {
+        if (shareUri == null || shareUri.trim().isEmpty()) {
+            throw new IllegalArgumentException("VLESS share link is empty");
+        }
+        preferences.edit().putString(KEY_SHARE_URI, shareUri.trim()).apply();
+    }
+
+    public void clear() {
+        preferences.edit().remove(KEY_SHARE_URI).apply();
+    }
+}
