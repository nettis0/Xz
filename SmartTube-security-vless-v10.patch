--- smarttube_baseline/SmartTube-master/tools/prepare-build.sh	1970-01-01 00:00:00.000000000 +0000
+++ smarttube_work/SmartTube-master/tools/prepare-build.sh	2026-10-29 16:00:33.072033027 +0000
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+clone_or_checkout() {
+  local name="$1" url="$2" commit="$3"
+  if [ ! -d "$name/.git" ]; then
+    if [ -e "$name" ] && [ -n "$(find "$name" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
+      echo "ERROR: $name exists but is not a git checkout and is not empty." >&2
+      echo "Move it aside, then rerun this script." >&2
+      exit 2
+    fi
+    rm -rf "$name"
+    git clone "$url" "$name"
+  fi
+  git -C "$name" fetch --all --tags --prune
+  git -C "$name" checkout "$commit"
+}
+
+command -v git >/dev/null || { echo "Install Git first." >&2; exit 1; }
+command -v java >/dev/null || { echo "Install OpenJDK 14 or older for this legacy project." >&2; exit 1; }
+JAVA_MAJOR="$(java -version 2>&1 | sed -n '1s/.*version "\([0-9]*\).*/\1/p')"
+if [ -z "$JAVA_MAJOR" ] || [ "$JAVA_MAJOR" -gt 14 ]; then
+  echo "This SmartTube revision documents OpenJDK 14 or older; detected Java ${JAVA_MAJOR:-unknown}." >&2
+  echo "Use a compatible JDK before building. This project warns newer JDKs can cause runtime crashes." >&2
+  exit 3
+fi
+
+# These revisions are the upstream submodule pins reported for the SmartTube source tree.
+clone_or_checkout SharedModules https://github.com/yuliskov/SharedModules.git 620808a
+clone_or_checkout MediaServiceCore https://github.com/yuliskov/MediaServiceCore.git 40fec84
+chmod +x ./gradlew
+
+echo "Dependencies prepared. Next run: ./tools/build-tv-debug.sh"
