+package com.liskovsoft.smartyoutubetv2.common.proxy.vless;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.net.URI;
+import java.net.URLDecoder;
+import java.util.LinkedHashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Converts a VLESS share URI into an Xray-core client configuration.
+ *
+ * This class only validates/parses profiles and builds JSON. It does not start Xray,
+ * create a VPN, or change SmartTube's network stack by itself.
+ */
+public final class VlessConfigBuilder {
+    private VlessConfigBuilder() { }
+
+    public static JSONObject buildXrayConfig(String shareUri) throws JSONException {
+        Profile p = parse(shareUri);
+
+        JSONObject user = new JSONObject();
+        user.put("id", p.uuid);
+        user.put("encryption", "none");
+        if (!p.flow.isEmpty()) user.put("flow", p.flow);
+
+        JSONObject outboundSettings = new JSONObject();
+        JSONArray vnext = new JSONArray();
+        JSONObject server = new JSONObject();
+        server.put("address", p.host);
+        server.put("port", p.port);
+        server.put("users", new JSONArray().put(user));
+        vnext.put(server);
+        outboundSettings.put("vnext", vnext);
+
+        JSONObject stream = new JSONObject();
+        stream.put("network", p.network);
+        if ("tls".equals(p.security) || "reality".equals(p.security)) {
+            if ("reality".equals(p.security)) {
+                // Xray Reality settings belong directly under streamSettings.realitySettings.
+                JSONObject reality = new JSONObject();
+                reality.put("serverName", p.sni.isEmpty() ? p.host : p.sni);
+                reality.put("fingerprint", p.fingerprint.isEmpty() ? "chrome" : p.fingerprint);
+                // Newer Xray releases renamed the client-side field to "password";
+                // older releases used "publicKey". Emit both for cross-version JSON
+                // compatibility; each core ignores the field it does not recognize.
+                reality.put("password", p.publicKey);
+                reality.put("publicKey", p.publicKey);
+                if (!p.shortId.isEmpty()) reality.put("shortId", p.shortId);
+                if (!p.spiderX.isEmpty()) reality.put("spiderX", p.spiderX);
+                stream.put("security", "reality");
+                stream.put("realitySettings", reality);
+            } else {
+                JSONObject tls = new JSONObject();
+                tls.put("serverName", p.sni.isEmpty() ? p.host : p.sni);
+                tls.put("allowInsecure", false);
+                if (!p.alpn.isEmpty()) {
+                    JSONArray alpn = new JSONArray();
+                    for (String protocol : p.alpn.split(",")) {
+                        String value = protocol.trim();
+                        if (!value.isEmpty()) alpn.put(value);
+                    }
+                    if (alpn.length() > 0) tls.put("alpn", alpn);
+                }
+                if (!p.fingerprint.isEmpty()) tls.put("fingerprint", p.fingerprint);
+                stream.put("security", "tls");
+                stream.put("tlsSettings", tls);
+            }
+        } else {
+            stream.put("security", "none");
+        }
+
+        JSONObject transport = new JSONObject();
+        if ("tcp".equals(p.network)) {
+            // Older VLESS links may use TCP with an HTTP camouflage header.
+            if (!p.headerType.isEmpty() && !"none".equals(p.headerType)) {
+                transport.put("header", new JSONObject().put("type", p.headerType));
+            }
+        } else if ("ws".equals(p.network)) {
+            transport.put("path", p.path.isEmpty() ? "/" : p.path);
+            if (!p.hostHeader.isEmpty()) transport.put("headers", new JSONObject().put("Host", p.hostHeader));
+        } else if ("grpc".equals(p.network)) {
+            transport.put("serviceName", p.serviceName);
+            if (p.mode.length() > 0) transport.put("multiMode", "multi".equals(p.mode));
+        } else if ("httpupgrade".equals(p.network)) {
+            transport.put("path", p.path.isEmpty() ? "/" : p.path);
+            // Xray HTTPUpgradeConfig uses a single string host, unlike HTTPConfig.
+            if (!p.hostHeader.isEmpty()) transport.put("host", p.hostHeader);
+        } else if ("http".equals(p.network)) {
+            transport.put("path", p.path.isEmpty() ? "/" : p.path);
+            // Xray HTTPConfig represents host as a list.
+            if (!p.hostHeader.isEmpty()) transport.put("host", new JSONArray().put(p.hostHeader));
+        } else if ("splithttp".equals(p.network)) {
+            transport.put("path", p.path.isEmpty() ? "/" : p.path);
+            if (!p.hostHeader.isEmpty()) transport.put("host", p.hostHeader);
+            if (!p.mode.isEmpty()) transport.put("mode", p.mode);
+            if (!p.extra.isEmpty()) {
+                try {
+                    transport.put("extra", new JSONObject(p.extra));
+                } catch (JSONException e) {
+                    throw new IllegalArgumentException("Invalid XHTTP extra JSON", e);
+                }
+            }
+        }
+        String transportSettingsName = "splithttp".equals(p.network) ? "splithttpSettings" : p.network + "Settings";
+        if (transport.length() > 0) stream.put(transportSettingsName, transport);
+
+        JSONObject outbound = new JSONObject();
+        outbound.put("protocol", "vless");
+        outbound.put("settings", outboundSettings);
+        outbound.put("streamSettings", stream);
+        outbound.put("tag", "secure-proxy");
+
+        JSONObject socksSettings = new JSONObject().put("auth", "noauth").put("udp", true);
+        JSONObject inbound = new JSONObject();
+        inbound.put("listen", "127.0.0.1");
+        inbound.put("port", 10808);
+        inbound.put("protocol", "socks");
+        inbound.put("settings", socksSettings);
+        inbound.put("tag", "local-socks");
+
+        JSONArray inbounds = new JSONArray().put(inbound);
+        JSONArray outbounds = new JSONArray().put(outbound)
+                .put(new JSONObject().put("protocol", "freedom").put("tag", "direct"));
+        JSONObject routing = new JSONObject().put("domainStrategy", "AsIs")
+                .put("rules", new JSONArray().put(new JSONObject()
+                        .put("type", "field")
+                        .put("inboundTag", new JSONArray().put("local-socks"))
+                        .put("outboundTag", "secure-proxy")));
+        return new JSONObject().put("log", new JSONObject().put("loglevel", "warning"))
+                .put("inbounds", inbounds).put("outbounds", outbounds).put("routing", routing);
+    }
+
+    public static Profile parse(String shareUri) {
+        if (shareUri == null || !shareUri.trim().toLowerCase(Locale.ROOT).startsWith("vless://")) {
+            throw new IllegalArgumentException("Expected a vless:// share link");
+        }
+        try {
+            URI uri = URI.create(shareUri.trim());
+            String uuid = uri.getUserInfo();
+            String host = uri.getHost();
+            int port = uri.getPort();
+            if (uuid == null || uuid.trim().isEmpty()) throw new IllegalArgumentException("Missing user UUID");
+            if (host == null || host.trim().isEmpty()) throw new IllegalArgumentException("Missing server host");
+            if (port < 1 || port > 65535) throw new IllegalArgumentException("Server port must be 1-65535");
+            if (!uuid.matches("(?i)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")) {
+                throw new IllegalArgumentException("Invalid VLESS UUID");
+            }
+            Map<String, String> q = parseQuery(uri.getRawQuery());
+            String network = valueOrDefault(q, "type", "tcp").toLowerCase(Locale.ROOT);
+            if ("raw".equals(network)) network = "tcp";
+            if ("websocket".equals(network)) network = "ws";
+            if ("xhttp".equals(network)) network = "splithttp";
+            if (!(network.equals("tcp") || network.equals("ws") || network.equals("grpc") || network.equals("http") || network.equals("httpupgrade") || network.equals("splithttp"))) {
+                throw new IllegalArgumentException("Unsupported transport: " + network);
+            }
+            String security = valueOrDefault(q, "security", "none").toLowerCase(Locale.ROOT);
+            if (!(security.equals("none") || security.equals("tls") || security.equals("reality"))) {
+                throw new IllegalArgumentException("Unsupported security mode: " + security);
+            }
+            if ("reality".equals(security) && first(q, "pbk", "publicKey").isEmpty()) {
+                throw new IllegalArgumentException("Reality profile is missing pbk/publicKey");
+            }
+            if ("reality".equals(security) && !(network.equals("tcp") || network.equals("grpc") || network.equals("splithttp"))) {
+                throw new IllegalArgumentException("Xray Reality supports TCP, gRPC and XHTTP transports");
+            }
+            String flow = first(q, "flow", "");
+            if (!flow.isEmpty() && !"xtls-rprx-vision".equals(flow)) {
+                throw new IllegalArgumentException("Unsupported VLESS flow: " + flow);
+            }
+            if ("xtls-rprx-vision".equals(flow)
+                    && !(network.equals("tcp") && (security.equals("tls") || security.equals("reality")))) {
+                throw new IllegalArgumentException("xtls-rprx-vision requires TCP with TLS or Reality security");
+            }
+            String shortId = first(q, "sid", "shortId");
+            if ("reality".equals(security) && (!shortId.matches("(?i)[0-9a-f]{0,16}") || shortId.length() % 2 != 0)) {
+                throw new IllegalArgumentException("Reality short ID must be an even-length hexadecimal value up to 16 characters");
+            }
+            return new Profile(uuid, host, port, network, security,
+                    flow, first(q, "sni", ""), first(q, "fp", ""),
+                    first(q, "pbk", "publicKey"), shortId, first(q, "spx", "spiderX"),
+                    first(q, "path", ""), first(q, "host", ""), first(q, "serviceName", "serviceName"),
+                    first(q, "mode", ""), first(q, "alpn", ""), first(q, "headerType", ""), first(q, "extra", ""), decode(uri.getRawFragment()));
+        } catch (IllegalArgumentException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new IllegalArgumentException("Malformed VLESS share link", e);
+        }
+    }
+
+    private static Map<String, String> parseQuery(String query) {
+        Map<String, String> result = new LinkedHashMap<>();
+        if (query == null || query.isEmpty()) return result;
+        for (String part : query.split("&")) {
+            int eq = part.indexOf('=');
+            String key = decode(eq < 0 ? part : part.substring(0, eq));
+            String value = decode(eq < 0 ? "" : part.substring(eq + 1));
+            result.put(key, value);
+        }
+        return result;
+    }
+
+    private static String first(Map<String, String> q, String key, String alternate) {
+        String value = q.get(key);
+        if (value == null || value.isEmpty()) value = q.get(alternate);
+        return value == null ? "" : value;
+    }
+
+    private static String valueOrDefault(Map<String, String> q, String key, String defaultValue) {
+        String value = q.get(key);
+        return value == null || value.isEmpty() ? defaultValue : value;
+    }
+
+    private static String decode(String value) {
+        if (value == null) return "";
+        try {
+            return URLDecoder.decode(value.replace("+", "%2B"), "UTF-8");
+        } catch (java.io.UnsupportedEncodingException impossible) {
+            throw new IllegalStateException(impossible);
+        }
+    }
+
+    public static final class Profile {
+        public final String uuid, host, network, security, flow, sni, fingerprint, publicKey, shortId;
+        public final String spiderX, path, hostHeader, serviceName, mode, alpn, headerType, extra, name;
+        public final int port;
+        private Profile(String uuid, String host, int port, String network, String security, String flow,
+                        String sni, String fingerprint, String publicKey, String shortId, String spiderX,
+                        String path, String hostHeader, String serviceName, String mode, String alpn,
+                        String headerType, String extra, String name) {
+            this.uuid = uuid; this.host = host; this.port = port; this.network = network; this.security = security;
+            this.flow = flow; this.sni = sni; this.fingerprint = fingerprint; this.publicKey = publicKey;
+            this.shortId = shortId; this.spiderX = spiderX; this.path = path; this.hostHeader = hostHeader;
+            this.serviceName = serviceName; this.mode = mode; this.alpn = alpn;
+            this.headerType = headerType; this.extra = extra; this.name = name;
+        }
+    }
+}
