+    /**
+     * TV-friendly controls for importing a VLESS profile and starting/stopping the
+     * optional libXray core. A live connection requires common/libs/libXray.aar to be
+     * built and included; the UI reports a failure if the native bridge is unavailable.
+     */
+    private void appendVlessProfile(AppDialogPresenter settingsPresenter) {
+        VlessProfileStore store = new VlessProfileStore(getContext());
+        String title = "VLESS profile (experimental)";
+        boolean tunnelActive = XrayVlessManager.instance(getContext()).isStarted();
+        String description = tunnelActive ? "VLESS is running for proxy-aware SmartTube requests" :
+                (store.hasProfile() ? "Profile saved; tunnel is stopped" : "Import a vless:// link; tunnel is stopped");
+        settingsPresenter.appendSingleButton(UiOptionItem.from(title, description, option -> {
+            SimpleEditDialog.show(getContext(), "Import VLESS profile", "vless://…", store.getShareUri(), value -> {
+                try {
+                    VlessConfigBuilder.Profile profile = VlessConfigBuilder.parse(value);
+                    // Generate once here so malformed transport-specific options are rejected before saving.
+                    VlessConfigBuilder.buildXrayConfig(value);
+                    store.saveShareUri(value);
+                    MessageHelpers.showMessage(getContext(), "VLESS profile saved: " + profile.host + ":" + profile.port + ". Open Network settings again to start it.");
+                    return true;
+                } catch (Exception e) {
+                    MessageHelpers.showMessage(getContext(), "Invalid VLESS profile: " + (e.getMessage() == null ? "check the link" : e.getMessage()));
+                    return false;
+                }
+            });
+        }));
+        if (store.hasProfile()) {
+            XrayVlessManager manager = XrayVlessManager.instance(getContext());
+            if (manager.isStarted()) {
+                settingsPresenter.appendSingleButton(UiOptionItem.from("Stop VLESS connection", option -> stopVless(manager, settingsPresenter)));
+            } else {
+                settingsPresenter.appendSingleButton(UiOptionItem.from("Start VLESS for SmartTube", option -> startVless(manager, settingsPresenter)));
+            }
+            settingsPresenter.appendSingleButton(UiOptionItem.from("Remove saved VLESS profile", option -> {
+                if (manager.isStarted()) {
+                    MessageHelpers.showMessage(getContext(), "Stop the VLESS connection before removing the profile");
+                    return;
+                }
+                store.clear();
+                MessageHelpers.showMessage(getContext(), "Saved VLESS profile removed");
+                settingsPresenter.closeDialog();
+            }));
+        }
+    }
+
+    private void startVless(XrayVlessManager manager, AppDialogPresenter settingsPresenter) {
+        settingsPresenter.closeDialog();
+        new Thread(() -> {
+            try {
+                manager.start();
+                new Handler(Looper.getMainLooper()).post(() -> MessageHelpers.showMessage(getContext(),
+                        "VLESS started. Only SmartTube requests that honor the app proxy are routed; this is not a device-wide VPN."));
+            } catch (Exception e) {
+                new Handler(Looper.getMainLooper()).post(() -> MessageHelpers.showMessage(getContext(),
+                        "VLESS could not start. Check that libXray is installed and the profile is valid."));
+            }
+        }, "smarttube-vless-start").start();
+    }
+
+    private void stopVless(XrayVlessManager manager, AppDialogPresenter settingsPresenter) {
+        settingsPresenter.closeDialog();
+        new Thread(() -> {
+            try {
+                manager.stop();
+                new Handler(Looper.getMainLooper()).post(() -> MessageHelpers.showMessage(getContext(), "VLESS stopped"));
