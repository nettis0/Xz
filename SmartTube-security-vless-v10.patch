+package com.liskovsoft.smartyoutubetv2.common.proxy.vless;
+
+import org.json.JSONObject;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class VlessConfigBuilderTest {
+    private static final String UUID = "01234567-89ab-cdef-0123-456789abcdef";
+
+
+    @Test public void defaultsToTcpWithoutSecurity() {
+        VlessConfigBuilder.Profile p = VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443");
+        assertEquals("tcp", p.network);
+        assertEquals("none", p.security);
+    }
+
+    @Test public void parsesTlsWebSocketProfile() {
+        VlessConfigBuilder.Profile p = VlessConfigBuilder.parse(
+                "vless://" + UUID + "@example.com:443?type=ws&security=tls&sni=cdn.example.com&path=%2Fvless&host=cdn.example.com#TV%20profile");
+        assertEquals("example.com", p.host);
+        assertEquals(443, p.port);
+        assertEquals("ws", p.network);
+        assertEquals("tls", p.security);
+        assertEquals("/vless", p.path);
+        assertEquals("TV profile", p.name);
+    }
+
+    @Test public void buildsLocalSocksInboundAndVlessOutbound() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@example.com:443?type=tcp&security=tls&sni=example.com");
+        assertEquals("socks", config.getJSONArray("inbounds").getJSONObject(0).getString("protocol"));
+        assertEquals("vless", config.getJSONArray("outbounds").getJSONObject(0).getString("protocol"));
+        assertEquals("example.com", config.getJSONArray("outbounds").getJSONObject(0)
+                .getJSONObject("settings").getJSONArray("vnext").getJSONObject(0).getString("address"));
+    }
+
+    @Test public void buildsRealitySettingsAtStreamLevel() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=tcp&security=reality&sni=front.example.com&fp=chrome&pbk=PUBLIC_KEY&sid=abcd");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        assertEquals("reality", stream.getString("security"));
+        JSONObject reality = stream.getJSONObject("realitySettings");
+        assertEquals("front.example.com", reality.getString("serverName"));
+        assertEquals("PUBLIC_KEY", reality.getString("publicKey"));
+        assertEquals("PUBLIC_KEY", reality.getString("password"));
+        assertEquals("abcd", reality.getString("shortId"));
+        assertFalse(stream.has("tlsSettings"));
+    }
+
+
+    @Test public void preservesTcpHttpHeaderCamouflage() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=tcp&headerType=http&security=none");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        assertEquals("tcp", stream.getString("network"));
+        assertEquals("http", stream.getJSONObject("tcpSettings").getJSONObject("header").getString("type"));
+    }
+
+    @Test public void doesNotEmitTcpSettingsForPlainTcp() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=tcp&security=none");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        assertFalse(stream.has("tcpSettings"));
+    }
+
+    @Test public void usesStringHostForHttpUpgradeTransport() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=httpupgrade&security=tls&host=cdn.example.com&path=%2Fedge");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        JSONObject settings = stream.getJSONObject("httpupgradeSettings");
+        assertEquals("cdn.example.com", settings.getString("host"));
+        assertEquals("/edge", settings.getString("path"));
+    }
+
+    @Test public void usesHostArrayForHttpTransport() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=http&security=tls&host=cdn.example.com");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        assertEquals("cdn.example.com", stream.getJSONObject("httpSettings").getJSONArray("host").getString(0));
+    }
+
+
+    @Test public void supportsXhttpRealityProfile() throws Exception {
+        VlessConfigBuilder.Profile p = VlessConfigBuilder.parse(
+                "vless://" + UUID + "@edge.example.com:443?type=xhttp&security=reality&pbk=PUBLIC_KEY&sid=abcd&sni=front.example.com&host=cdn.example.com&path=%2Fedge&mode=stream-up&extra=%7B%22scMaxEachPostBytes%22%3A100000%7D");
+        assertEquals("splithttp", p.network);
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=xhttp&security=reality&pbk=PUBLIC_KEY&sid=abcd&sni=front.example.com&host=cdn.example.com&path=%2Fedge&mode=stream-up&extra=%7B%22scMaxEachPostBytes%22%3A100000%7D");
+        JSONObject stream = config.getJSONArray("outbounds").getJSONObject(0).getJSONObject("streamSettings");
+        JSONObject settings = stream.getJSONObject("splithttpSettings");
+        assertEquals("/edge", settings.getString("path"));
+        assertEquals("cdn.example.com", settings.getString("host"));
+        assertEquals("stream-up", settings.getString("mode"));
+        assertEquals(100000, settings.getJSONObject("extra").getInt("scMaxEachPostBytes"));
+    }
+
+    @Test public void normalizesRawAndWebsocketAliases() {
+        assertEquals("tcp", VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?type=raw").network);
+        assertEquals("ws", VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?type=websocket").network);
+    }
+
+    @Test public void acceptsVisionFlowForTcpReality() throws Exception {
+        JSONObject config = VlessConfigBuilder.buildXrayConfig(
+                "vless://" + UUID + "@edge.example.com:443?type=tcp&security=reality&pbk=PUBLIC_KEY&flow=xtls-rprx-vision");
+        JSONObject user = config.getJSONArray("outbounds").getJSONObject(0)
+                .getJSONObject("settings").getJSONArray("vnext").getJSONObject(0)
+                .getJSONArray("users").getJSONObject(0);
+        assertEquals("xtls-rprx-vision", user.getString("flow"));
+    }
+
+    @Test public void rejectsVisionFlowForWebSocket() {
+        try {
+            VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?type=ws&security=tls&flow=xtls-rprx-vision");
+            fail("Vision flow must not be used with WebSocket");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test public void rejectsUnknownVlessFlow() {
+        try {
+            VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?type=tcp&security=tls&flow=unknown-flow");
+            fail("Unknown VLESS flow should be rejected");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test public void rejectsRealityWithUnsupportedTransport() {
+        try {
+            VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?type=ws&security=reality&pbk=PUBLIC_KEY");
+            fail("Reality must reject WebSocket transport");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test public void rejectsMalformedRealityShortId() {
+        try {
+            VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?security=reality&pbk=PUBLIC_KEY&sid=abc");
+            fail("Odd-length Reality short ID should be rejected");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test public void rejectsMalformedXhttpExtraJson() {
+        try {
+            VlessConfigBuilder.buildXrayConfig("vless://" + UUID + "@example.com:443?type=xhttp&extra=%7Bbad%7D");
+            fail("Malformed extra JSON should be rejected");
+        } catch (Exception expected) { }
+    }
+
+    @Test public void rejectsRealityWithoutPublicKey() {
+        try {
+            VlessConfigBuilder.parse("vless://" + UUID + "@example.com:443?security=reality");
+            fail("Reality profile without public key should be rejected");
+        } catch (IllegalArgumentException expected) { }
+    }
+
+    @Test public void rejectsNonVlessAndBadPorts() {
+        try { VlessConfigBuilder.parse("https://example.com"); fail("scheme should be rejected"); }
+        catch (IllegalArgumentException expected) { }
+        try { VlessConfigBuilder.parse("vless://" + UUID + "@example.com:99999?security=none"); fail("port should be rejected"); }
+        catch (IllegalArgumentException expected) { }
+    }
+}
