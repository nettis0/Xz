diff -ruN smarttube_baseline/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/VlessConfigBuilder.java smarttube_work/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/VlessConfigBuilder.java
--- smarttube_baseline/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/VlessConfigBuilder.java	1970-01-01 00:00:00.000000000 +0000
+++ smarttube_work/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/VlessConfigBuilder.java	2026-10-29 16:35:07.780266985 +0000
