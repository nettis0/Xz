--- smarttube_baseline/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/XrayVlessManager.java	1970-01-01 00:00:00.000000000 +0000
+++ smarttube_work/SmartTube-master/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/proxy/vless/XrayVlessManager.java	2026-10-29 16:28:22.409434391 +0000
@@ -0,0 +1,143 @@
+package com.liskovsoft.smartyoutubetv2.common.proxy.vless;
+
+import android.content.Context;
+
+import com.liskovsoft.sharedutils.okhttp.OkHttpManager;
+import com.liskovsoft.smartyoutubetv2.common.prefs.GeneralData;
+import com.liskovsoft.smartyoutubetv2.common.prefs.PlayerTweaksData;
+import com.liskovsoft.smartyoutubetv2.common.proxy.PasswdInetSocketAddress;
+import com.liskovsoft.smartyoutubetv2.common.proxy.Proxy;
+import com.liskovsoft.smartyoutubetv2.common.proxy.ProxyManager;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.lang.reflect.Method;
+
+/**
+ * Optional libXray bridge for SmartTube's local-SOCKS VLESS mode.
+ * The libXray AAR is supplied separately under common/libs; without it this class
+ * reports a clear error instead of pretending that a tunnel is running.
+ * This routes only app clients that honor SmartTube's configured proxy; it is not a VPN.
+ */
+public final class XrayVlessManager {
+    private static XrayVlessManager instance;
+    private final Context context;
+    private final VlessProfileStore profileStore;
+    private Proxy previousProxy;
+    private boolean previousProxyEnabled;
+    private boolean previousGeneralProxyEnabled;
+    private int previousDataSource;
+    private boolean started;
+
+    private XrayVlessManager(Context context) {
+        this.context = context.getApplicationContext();
+        profileStore = new VlessProfileStore(this.context);
+    }
+
+    public static synchronized XrayVlessManager instance(Context context) {
+        if (instance == null) instance = new XrayVlessManager(context);
+        return instance;
+    }
+
+    public synchronized boolean isStarted() {
+        return started;
+    }
+
+    public synchronized void start() throws Exception {
+        if (started) return;
+        String link = profileStore.getShareUri();
+        if (link.isEmpty()) throw new IllegalStateException("Import a VLESS profile first");
+
+        ProxyManager proxyManager = new ProxyManager(context);
+        previousProxy = proxyManager.getCurrentProxy();
+        previousProxyEnabled = proxyManager.isProxyEnabled();
+        previousGeneralProxyEnabled = GeneralData.instance(context).isProxyEnabled();
+        PlayerTweaksData tweaks = PlayerTweaksData.instance(context);
+        previousDataSource = tweaks.getPlayerDataSource();
+
+        boolean coreStarted = false;
+        boolean proxyChanged = false;
+        try {
+            JSONObject config = VlessConfigBuilder.buildXrayConfig(link);
+            invokeCore("runXray", new JSONObject().put("xrayJson", config.toString()));
+            coreStarted = true;
+
+            Proxy localSocks = new Proxy(Proxy.Type.SOCKS,
+                    PasswdInetSocketAddress.createUnresolved("127.0.0.1", 10808, null, null));
+            proxyManager.saveProxyInfoToPrefs(localSocks, true);
+            proxyChanged = true;
+            if (!proxyManager.configureSystemProxy()) {
+                throw new IllegalStateException("SmartTube could not apply the local SOCKS proxy");
+            }
+            GeneralData.instance(context).setProxyEnabled(true);
+            tweaks.setPlayerDataSource(PlayerTweaksData.PLAYER_DATA_SOURCE_OKHTTP);
+            OkHttpManager.unhold();
+            started = true;
+        } catch (Exception e) {
+            if (proxyChanged) {
+                try { restoreProxySettings(); } catch (Exception ignored) { }
+            }
+            if (coreStarted) {
+                try { invokeCore("stopXray", new JSONObject()); } catch (Exception ignored) { }
+            }
+            throw e;
+        }
+    }
+
+    public synchronized void stop() throws Exception {
+        if (!started) return;
+        Exception failure = null;
+        try {
+            // Restore app networking first, then stop the local listener.
+            restoreProxySettings();
+        } catch (Exception e) {
+            failure = e;
+        }
+        try {
+            invokeCore("stopXray", new JSONObject());
+        } catch (Exception e) {
+            if (failure == null) failure = e;
+        } finally {
+            started = false;
+            OkHttpManager.unhold();
+        }
+        if (failure != null) throw failure;
+    }
+
+    private void restoreProxySettings() {
+        ProxyManager proxyManager = new ProxyManager(context);
+        proxyManager.saveProxyInfoToPrefs(previousProxy, previousProxyEnabled);
+        proxyManager.configureSystemProxy();
+        GeneralData.instance(context).setProxyEnabled(previousGeneralProxyEnabled);
+        PlayerTweaksData.instance(context).setPlayerDataSource(previousDataSource);
+    }
+
+    private JSONObject invokeCore(String methodName, JSONObject payload) throws Exception {
+        Class<?> bridge = findBridgeClass();
+        Method invoke = bridge.getMethod("invoke", String.class);
+        JSONObject request = new JSONObject();
+        request.put("apiVersion", 3);
+        request.put("method", methodName);
+        request.put("payload", payload);
+        Object result = invoke.invoke(null, request.toString());
+        if (!(result instanceof String)) throw new IllegalStateException("libXray returned an invalid response");
+        JSONObject response = new JSONObject((String) result);
+        if (!response.optBoolean("success", false)) {
+            String error = response.optString("error", "Xray core request failed");
+            // Core errors can contain config snippets. Do not log or persist them.
+            throw new IllegalStateException(error.isEmpty() ? "Xray core request failed" : error);
+        }
+        return response;
+    }
+
+    private Class<?> findBridgeClass() throws ClassNotFoundException {
+        String[] candidates = {"libXray.LibXray", "libxray.LibXray", "libxray.Libxray"};
+        ClassLoader loader = context.getClassLoader();
+        for (String name : candidates) {
+            try { return Class.forName(name, true, loader); }
+            catch (ClassNotFoundException ignored) { }
+        }
+        throw new ClassNotFoundException("libXray Android AAR is missing. Add the built AAR to common/libs/libXray.aar");
+    }
+}
